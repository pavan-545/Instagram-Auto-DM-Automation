# Database Configuration (PostgreSQL URL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/linkplease

# PseudoGram Host API Configuration
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com
PSEUDOGRAM_API_KEY=your_pseudogram_api_key_here

# Webhook Security Secret
WEBHOOK_SECRET=your_webhook_secret_here

# Redis URL (Optional / Queue fallback)
REDIS_URL=redis://localhost:6379/0

# Rate Limit & Worker Configurations
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
WORKER_INTERVAL_SECONDS=1.0
WORKER_RECONCILE_INTERVAL_SECONDS=2.0
WORKER_ENABLED=True
